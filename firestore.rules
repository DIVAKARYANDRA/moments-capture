rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // users collection: admins can read; a user may read their own doc to check role.
    // No client-side writes — create admin users via the Firebase Console or Admin SDK.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // Public, read-only, admin-editable content collections.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /founders/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portfolio/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Enquiries: anyone can submit (create) an enquiry from the contact form,
    // but only admins can read, update (status), or delete them.
    match /enquiries/{docId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'eventType', 'status']) &&
                       request.resource.data.status == 'New';
      allow read, update, delete: if isAdmin();
    }
  }
}
